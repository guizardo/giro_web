# Backend Delphi MVC_LOGIDOC (usado apenas como fallback quando não há sessão ativa)
BACKEND_URL=
BACKEND_USER=
BACKEND_PASS=

# Filial padrão (quando o cookie giro_filial não está definido)
FILIAL=1

# Servidor local de resolução/token (VPS)
VPS_URL=
NEXT_PUBLIC_VPS_URL=

# Chave exigida pelo giro360_backend em GET /giro/token (header X-App-Key).
# Server-side apenas - precisa ser o MESMO valor do APP_TOKEN_KEY do backend.
APP_TOKEN_KEY=
